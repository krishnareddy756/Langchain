# ==========================================
# API Credentials
# ==========================================
GOOGLE_API_KEY=your_google_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# ==========================================
# Default Chat Model Configuration
# ==========================================
# Options for LLM_PROVIDER: "google", "openai", "groq"
DEFAULT_CHAT_PROVIDER=google
GOOGLE_CHAT_MODEL=gemini-3.5-flash
OPENAI_CHAT_MODEL=gpt-4o-mini
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# ==========================================
# Default Embedding Configuration
# ==========================================
# Options for EMBEDDING_PROVIDER: "google", "openai"
DEFAULT_EMBEDDING_PROVIDER=google
GOOGLE_EMBEDDING_MODEL=models/text-embedding-004
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_CONFIG_VERSION=v1.0.0
